{
  "name": "qevon-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "// build": "tsc runs first on purpose: Vite strips types without checking them, so without this a type error builds clean and ships. This is what makes Vercel fail the deploy instead.",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "images": "node scripts/optimize-images.mjs",
    "og": "node scripts/make-og-image.mjs",
    "format": "oxfmt"
  },
  "dependencies": {
    "framer-motion": "^13.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  }
}
